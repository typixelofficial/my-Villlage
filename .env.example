# APP_URL: The public URL where TYPIXEL OPEN WORLD is hosted.
APP_URL="http://localhost:3000"

# PORT: Server port (must be 3000 in AI Studio preview).
PORT="3000"

# ADMIN_EMAILS: Optional comma-separated extra verified Google admin emails (owner account is built-in).
ADMIN_EMAILS=""

# Custom Admin Login credentials (never commit real secrets; configure in Settings -> Secrets or first-run claim UI)
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Optional initial access key for Hashim's Villa (hashed server-side; owner __hashim_mhd_ or Admin can change anytime)
HASHIM_VILLA_DEFAULT_KEY=""

# Optional: Real-time Instagram Data API credentials (e.g., RapidAPI Instagram provider)
INSTAGRAM_VERIFY_API_KEY=""
INSTAGRAM_VERIFY_API_HOST=""

# Optional Firebase Web Config overrides (loaded automatically from firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
