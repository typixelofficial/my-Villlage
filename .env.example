# APP_URL: The public URL where TYPIXEL OPEN WORLD is hosted.
APP_URL="http://localhost:3000"

# PORT: Server port (must be 3000 in AI Studio preview).
PORT="3000"

# ADMIN_EMAILS: Optional comma-separated extra verified Google admin emails (owner account is built-in).
ADMIN_EMAILS=""

# Optional: Real-time Instagram Data API credentials (e.g., RapidAPI Instagram provider) for live follower checks.
# Keep these strictly on the server (never prefix with VITE_). Without these, the server verifies against
# the Admin-synced follower lists of @typixelofficial and @typixel.studio stored in Firestore.
INSTAGRAM_VERIFY_API_KEY=""
INSTAGRAM_VERIFY_API_HOST=""

# Optional Firebase Web Config overrides (loaded automatically from firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
