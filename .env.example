# APP_URL: The public URL where TYPIXEL OPEN WORLD is hosted.
APP_URL="http://localhost:3000"

# PORT: Server port (must be 3000 in AI Studio preview).
PORT="3000"

# ADMIN_PASSCODE: Optional server-side Admin Studio passcode (leave empty to claim on first run via Admin Login).
ADMIN_PASSCODE=""

# Optional Firebase Web Config overrides (loaded automatically from firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
