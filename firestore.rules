rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrappedAdmin() {
      return isSignedIn()
        && 'email' in request.auth.token
        && request.auth.token.email == 'hashimtypixel@gmail.com'
        && 'email_verified' in request.auth.token
        && request.auth.token.email_verified == true;
    }

    // Admin check strictly mandates verified email (blocks email spoofing) or trusted admins doc
    function isAdmin() {
      return isBootstrappedAdmin()
        || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidIgDocId(id) {
      return id is string && id.size() >= 1 && id.size() <= 30 && id.matches('^[a-z0-9._]+$');
    }

    // Lightweight hex color check without consuming Firestore's per-request regex budget
    function isHexColor(val) {
      return val is string && val.size() >= 4 && val.size() <= 9 && val[0:1] == '#';
    }

    function isValidInstagram(val) {
      return val is string && (val == '' || (val.size() <= 30 && val.matches('^[a-zA-Z0-9._]+$')));
    }

    function isValidDateStr(val) {
      return val is string && (val == '' || (val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
    }

    function isValidLocationList(arr) {
      return arr is list && arr.size() <= 15 && (
        arr.size() == 0 || (
          arr[0] is map
          && arr[0].size() == 5
          && arr[0].keys().hasOnly(['id', 'name', 'category', 'x', 'z'])
          && arr[0].id is string && arr[0].id.size() >= 1 && arr[0].id.size() <= 64
          && arr[0].name is string && arr[0].name.size() >= 1 && arr[0].name.size() <= 32
          && arr[0].category in ['favorite', 'home', 'hangout', 'tea', 'event']
          && arr[0].x is number && arr[0].x >= -1000 && arr[0].x <= 1000
          && arr[0].z is number && arr[0].z >= -1000 && arr[0].z <= 1000
        )
      );
    }

    function isValidAppearance(app) {
      return app is map
        && app.size() == 9
        && app.keys().hasOnly([
          'gender', 'skinTone', 'hairStyle', 'hairColor',
          'shirtStyle', 'shirtColor', 'pantsColor', 'shoeColor', 'accessory'
        ])
        && app.gender in ['male', 'female']
        && isHexColor(app.skinTone)
        && app.hairStyle in ['short', 'long', 'spiky', 'bob', 'ponytail', 'braids', 'fade', 'curly']
        && isHexColor(app.hairColor)
        && app.shirtStyle in ['tee', 'jacket', 'hoodie', 'polo', 'shirt', 'mundu', 'dress', 'kurti', 'lehenga']
        && isHexColor(app.shirtColor)
        && isHexColor(app.pantsColor)
        && isHexColor(app.shoeColor)
        && app.accessory in ['none', 'glasses', 'cap', 'backpack', 'headphones'];
    }

    function isValidPosition(pos) {
      return pos is map
        && pos.size() == 3
        && pos.keys().hasOnly(['x', 'y', 'z'])
        && pos.x is number && pos.x >= -1000 && pos.x <= 1000
        && pos.y is number && pos.y >= -50 && pos.y <= 300
        && pos.z is number && pos.z >= -1000 && pos.z <= 1000;
    }

    function isValidPlayerOptional(data) {
      return (!('age' in data) || (data.age is number && data.age >= 18 && data.age <= 90))
        && (!('relationshipStatus' in data) || data.relationshipStatus in ['single', 'mingle', 'married'])
        && (!('partnerUid' in data) || (data.partnerUid is string && data.partnerUid.size() <= 128))
        && (!('partnerName' in data) || (data.partnerName is string && data.partnerName.size() <= 32))
        && (!('partnerInstagram' in data) || isValidInstagram(data.partnerInstagram))
        && (!('lastDailyLoginDate' in data) || isValidDateStr(data.lastDailyLoginDate))
        && (!('dailyLoginStreak' in data) || (data.dailyLoginStreak is number && data.dailyLoginStreak >= 0 && data.dailyLoginStreak <= 365))
        && (!('totalDailyLogins' in data) || (data.totalDailyLogins is number && data.totalDailyLogins >= 0 && data.totalDailyLogins <= 10000))
        && (!('followedOfficial' in data) || data.followedOfficial is bool)
        && (!('followedStudio' in data) || data.followedStudio is bool)
        && (!('muscleLevel' in data) || (data.muscleLevel is number && data.muscleLevel >= 0 && data.muscleLevel <= 10))
        && (!('hasGameCenterCard' in data) || data.hasGameCenterCard is bool)
        && (!('customLocations' in data) || isValidLocationList(data.customLocations));
    }

    function isValidPlayerLists(data) {
      return data.ownedProperties is list && data.ownedProperties.size() <= 30
        && data.ownedBusinesses is list && data.ownedBusinesses.size() <= 10
        && data.ownedVehicles is list && data.ownedVehicles.size() <= 20
        && data.completedMissions is list && data.completedMissions.size() <= 50
        && data.claimedRewards is list && data.claimedRewards.size() <= 30
        && data.inventory is list && data.inventory.size() <= 30
        && data.friends is list && data.friends.size() <= 50;
    }

    function isValidNewPlayer(data, uid) {
      return data.keys().hasOnly([
          'uid', 'displayName', 'instagramId', 'photoURL', 'appearance',
          'age', 'relationshipStatus', 'partnerUid', 'partnerName', 'partnerInstagram',
          'lastDailyLoginDate', 'dailyLoginStreak', 'totalDailyLogins',
          'followedOfficial', 'followedStudio', 'muscleLevel', 'hasGameCenterCard', 'customLocations',
          'greenCoins', 'level', 'xp',
          'ownedProperties', 'ownedBusinesses', 'ownedVehicles',
          'completedMissions', 'claimedRewards',
          'inventory', 'friends', 'lastPosition', 'createdAt', 'updatedAt'
        ])
        && data.uid == uid
        && data.displayName is string
        && data.displayName.size() >= 2 && data.displayName.size() <= 24
        && data.displayName.matches('^[a-zA-Z0-9 _-]+$')
        && isValidInstagram(data.instagramId)
        && data.photoURL is string && data.photoURL.size() <= 512
        && isValidAppearance(data.appearance)
        && isValidPosition(data.lastPosition)
        && isValidPlayerOptional(data)
        && data.greenCoins == 1500
        && data.level == 1
        && data.xp == 0
        && data.ownedProperties is list && data.ownedProperties.size() == 0
        && data.ownedBusinesses is list && data.ownedBusinesses.size() == 0
        && data.ownedVehicles is list && data.ownedVehicles.size() == 0
        && data.completedMissions is list && data.completedMissions.size() == 0
        && data.claimedRewards is list && data.claimedRewards.size() == 0
        && data.inventory is list && data.inventory.size() == 0
        && data.friends is list && data.friends.size() == 0
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidUpdatedPlayer(data, prev, uid) {
      return data.uid == uid
        && data.uid == prev.uid
        && data.createdAt == prev.createdAt
        && data.updatedAt == request.time
        && data.displayName is string
        && data.displayName.size() >= 2 && data.displayName.size() <= 24
        && (data.displayName == prev.displayName || data.displayName.matches('^[a-zA-Z0-9 _-]+$'))
        && (data.instagramId == prev.instagramId || isValidInstagram(data.instagramId))
        && data.photoURL is string && data.photoURL.size() <= 512
        && (data.appearance == prev.appearance || isValidAppearance(data.appearance))
        && (data.lastPosition == prev.lastPosition || isValidPosition(data.lastPosition))
        && data.greenCoins is number && data.greenCoins >= 0 && data.greenCoins <= 10000000
        && data.level is number && data.level >= 1 && data.level <= 100
        && data.xp is number && data.xp >= 0 && data.xp <= 1000000
        && isValidPlayerOptional(data)
        && isValidPlayerLists(data);
    }

    function isValidPrivateAccount(data, uid) {
      return data.size() == 5
        && data.keys().hasOnly(['uid', 'email', 'googleName', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.googleName is string && data.googleName.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data, uid) {
      return data.size() == 6
        && data.keys().hasOnly(['uid', 'type', 'amount', 'reason', 'balanceAfter', 'createdAt'])
        && data.uid == uid
        && data.uid == request.auth.uid
        && data.type in ['earn', 'spend']
        && data.amount is number && data.amount > 0 && data.amount <= 50000
        && data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 120
        && data.balanceAfter is number && data.balanceAfter >= 0 && data.balanceAfter <= 10000000
        && data.createdAt is timestamp;
    }

    function isValidProperty(data, propertyId) {
      return data.size() == 8
        && data.keys().hasOnly([
          'propertyId', 'ownerUid', 'ownerName',
          'interiorTheme', 'gardenStyle', 'isPublic',
          'purchasedAt', 'updatedAt'
        ])
        && data.propertyId == propertyId
        && isValidId(data.ownerUid)
        && data.ownerName is string
        && data.ownerName.size() >= 2 && data.ownerName.size() <= 24
        && data.ownerName.matches('^[a-zA-Z0-9 _-]+$')
        && data.interiorTheme in ['modern', 'cozy', 'minimal', 'luxury']
        && data.gardenStyle in ['flowers', 'zen', 'poolside', 'orchard']
        && data.isPublic is bool && data.isPublic == true
        && data.purchasedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomHome(data, homeId) {
      return data.keys().hasOnly([
          'homeId', 'name', 'ownerUid', 'ownerName', 'ownerInstagram',
          'createdByAdmin', 'style', 'wallColor', 'roofColor', 'hasPool',
          'hasGarden', 'hasAc', 'interiorTheme', 'gardenStyle', 'x', 'y', 'z',
          'isPublic', 'createdAt', 'updatedAt'
        ])
        && data.homeId == homeId
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 32
        && data.name.matches('^[a-zA-Z0-9 _-]+$')
        && isValidId(data.ownerUid)
        && data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 24
        && data.ownerName.matches('^[a-zA-Z0-9 _-]+$')
        && isValidInstagram(data.ownerInstagram)
        && data.createdByAdmin is bool
        && data.style in ['cabin', 'modern', 'villa', 'manor']
        && isHexColor(data.wallColor)
        && isHexColor(data.roofColor)
        && data.hasPool is bool
        && (!('hasGarden' in data) || data.hasGarden is bool)
        && (!('hasAc' in data) || data.hasAc is bool)
        && data.interiorTheme in ['modern', 'cozy', 'minimal', 'luxury']
        && data.gardenStyle in ['flowers', 'zen', 'poolside', 'orchard']
        && data.x is number && data.x >= -1000 && data.x <= 1000
        && data.y is number && data.y >= -10 && data.y <= 50
        && data.z is number && data.z >= -1000 && data.z <= 1000
        && data.isPublic is bool && data.isPublic == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomShop(data, shopId) {
      return data.keys().hasOnly([
          'shopId', 'name', 'shopType', 'ownerUid', 'ownerName', 'ownerInstagram',
          'awningColor', 'ownerKeyHash', 'sizeTier', 'hasSeating', 'hasAc',
          'x', 'y', 'z', 'totalSales', 'isPublic',
          'createdAt', 'updatedAt'
        ])
        && data.shopId == shopId
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 32
        && data.name.matches('^[a-zA-Z0-9 _-]+$')
        && data.shopType in ['tea_stall', 'juice_bar', 'bakery', 'boutique', 'tech_shop']
        && isValidId(data.ownerUid)
        && data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 24
        && data.ownerName.matches('^[a-zA-Z0-9 _-]+$')
        && isValidInstagram(data.ownerInstagram)
        && isHexColor(data.awningColor)
        && (!('ownerKeyHash' in data) || (data.ownerKeyHash is string && data.ownerKeyHash.size() <= 128))
        && (!('sizeTier' in data) || data.sizeTier in ['small', 'medium', 'large', 'palace'])
        && (!('hasSeating' in data) || data.hasSeating is bool)
        && (!('hasAc' in data) || data.hasAc is bool)
        && data.x is number && data.x >= -1000 && data.x <= 1000
        && data.y is number && data.y >= -10 && data.y <= 50
        && data.z is number && data.z >= -1000 && data.z <= 1000
        && data.totalSales is number && data.totalSales >= 0 && data.totalSales <= 1000000
        && data.isPublic is bool && data.isPublic == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicAd(data, adId) {
      return data.size() == 9
        && data.keys().hasOnly([
          'adId', 'title', 'subtitle', 'instagramHandle',
          'accentColor', 'ownerUid', 'ownerName', 'isPublic', 'createdAt'
        ])
        && data.adId == adId
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 42
        && data.subtitle is string && data.subtitle.size() >= 2 && data.subtitle.size() <= 96
        && isValidInstagram(data.instagramHandle)
        && isHexColor(data.accentColor)
        && isValidId(data.ownerUid)
        && data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 24
        && data.isPublic is bool && data.isPublic == true
        && data.createdAt is timestamp;
    }

    function isValidVerifiedFollower(data, igDocId) {
      return data.size() == 5
        && data.keys().hasOnly(['instagramId', 'followsOfficial', 'followsStudio', 'source', 'updatedAt'])
        && data.instagramId == igDocId
        && data.followsOfficial is bool
        && data.followsStudio is bool
        && data.source in ['admin_sync', 'instagram_export', 'live_api']
        && data.updatedAt is timestamp;
    }

    // 0. Trusted Admins Registry (read own status only, no client writes)
    match /admins/{adminUid} {
      allow get: if isOwner(adminUid) && isValidId(adminUid);
      allow list, create, update, delete: if false;
    }

    // 1. Public Player Profiles (Zero Private Email PII)
    match /players/{uid} {
      allow get: if isSignedIn() && isValidId(uid);
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isBootstrappedAdmin());

      allow create: if isOwner(uid)
        && isValidId(uid)
        && isValidNewPlayer(request.resource.data, uid);

      allow update: if isSignedIn()
        && isValidId(uid)
        && isValidUpdatedPlayer(request.resource.data, resource.data, uid)
        && (
          (
            isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName', 'instagramId', 'photoURL', 'appearance',
              'age', 'relationshipStatus', 'partnerUid', 'partnerName', 'partnerInstagram',
              'lastDailyLoginDate', 'dailyLoginStreak', 'totalDailyLogins',
              'followedOfficial', 'followedStudio', 'muscleLevel', 'hasGameCenterCard', 'customLocations',
              'greenCoins', 'level', 'xp', 'ownedProperties',
              'ownedBusinesses', 'ownedVehicles', 'completedMissions',
              'claimedRewards', 'inventory', 'friends', 'lastPosition', 'updatedAt'
            ])
            && request.resource.data.greenCoins <= resource.data.greenCoins + 2500
          )
          || isAdmin()
        );

      allow delete: if false;

      // 1a. Isolated Private Account PII (Owner Only — parent players/{uid} created first)
      match /private/{docId} {
        allow get: if isOwner(uid) && isValidId(uid) && isValidId(docId);
        allow list: if isOwner(uid) && resource.data.uid == request.auth.uid;

        allow create: if isOwner(uid)
          && isValidId(uid)
          && isValidId(docId)
          && docId == 'account'
          && isValidPrivateAccount(request.resource.data, uid)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && exists(/databases/$(database)/documents/players/$(uid));

        allow update: if isOwner(uid)
          && isValidId(uid)
          && isValidId(docId)
          && docId == 'account'
          && isValidPrivateAccount(request.resource.data, uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'googleName', 'updatedAt'])
          && exists(/databases/$(database)/documents/players/$(uid));

        allow delete: if false;
      }

      // 1b. Immutable Wallet Transactions (Owner Only)
      match /transactions/{txId} {
        allow get: if isOwner(uid) && isValidId(uid) && isValidId(txId);
        allow list: if isOwner(uid) && resource.data.uid == request.auth.uid;

        allow create: if isOwner(uid)
          && isValidId(uid)
          && isValidId(txId)
          && isValidTransaction(request.resource.data, uid)
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/players/$(uid));

        allow update: if false;
        allow delete: if false;
      }
    }

    // 2. Shared World Pre-Built Properties
    match /properties/{propertyId} {
      allow get: if isSignedIn() && isValidId(propertyId);
      allow list: if isSignedIn() && resource.data.isPublic == true;

      allow create: if isSignedIn()
        && isValidId(propertyId)
        && isValidProperty(request.resource.data, propertyId)
        && (request.resource.data.ownerUid == request.auth.uid || isAdmin())
        && request.resource.data.purchasedAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/players/$(request.auth.uid));

      allow update: if isSignedIn()
        && isValidId(propertyId)
        && isValidProperty(request.resource.data, propertyId)
        && (resource.data.ownerUid == request.auth.uid || isAdmin())
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.propertyId == resource.data.propertyId
        && request.resource.data.purchasedAt == resource.data.purchasedAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerName', 'interiorTheme', 'gardenStyle', 'updatedAt']);

      allow delete: if false;
    }

    // 3. Dynamically Built Custom 3D Homes (Player-built with Green Coins or Admin-built for anyone)
    match /customHomes/{homeId} {
      allow get: if isSignedIn() && isValidId(homeId);
      allow list: if isSignedIn() && resource.data.isPublic == true;

      allow create: if isSignedIn()
        && isValidId(homeId)
        && isValidCustomHome(request.resource.data, homeId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/players/$(request.auth.uid))
        && (
          isAdmin()
          || (request.resource.data.ownerUid == request.auth.uid && request.resource.data.createdByAdmin == false)
        );

      allow update: if isSignedIn()
        && isValidId(homeId)
        && isValidCustomHome(request.resource.data, homeId)
        && request.resource.data.homeId == resource.data.homeId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          isAdmin()
          || (
            resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.createdByAdmin == resource.data.createdByAdmin
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'ownerName', 'ownerInstagram', 'wallColor', 'roofColor',
              'hasGarden', 'hasAc', 'interiorTheme', 'gardenStyle', 'updatedAt'
            ])
          )
        );

      allow delete: if isAdmin() && isValidId(homeId);
    }

    // 4. Player-Opened Custom 3D Shops & Tea Stalls (with hashed secret owner interior key)
    match /customShops/{shopId} {
      allow get: if isSignedIn() && isValidId(shopId);
      allow list: if isSignedIn() && resource.data.isPublic == true;

      allow create: if isSignedIn()
        && isValidId(shopId)
        && isValidCustomShop(request.resource.data, shopId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.totalSales == 0
        && (request.resource.data.ownerUid == request.auth.uid || isAdmin())
        && exists(/databases/$(database)/documents/players/$(request.auth.uid));

      allow update: if isSignedIn()
        && isValidId(shopId)
        && isValidCustomShop(request.resource.data, shopId)
        && request.resource.data.shopId == resource.data.shopId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          isAdmin()
          || (
            resource.data.ownerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'awningColor', 'ownerKeyHash', 'sizeTier', 'hasSeating', 'hasAc', 'totalSales', 'updatedAt'
            ])
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalSales', 'updatedAt'])
            && request.resource.data.totalSales >= resource.data.totalSales
            && request.resource.data.totalSales <= resource.data.totalSales + 5
          )
        );

      allow delete: if isSignedIn()
        && isValidId(shopId)
        && (isAdmin() || resource.data.ownerUid == request.auth.uid);
    }

    // 5. Public Citizen Advertisements (Published at Green Valley Public Ad Center)
    match /publicAds/{adId} {
      allow get: if isSignedIn() && isValidId(adId);
      allow list: if isSignedIn() && resource.data.isPublic == true;

      allow create: if isSignedIn()
        && isValidId(adId)
        && isValidPublicAd(request.resource.data, adId)
        && request.resource.data.createdAt == request.time
        && (request.resource.data.ownerUid == request.auth.uid || isAdmin())
        && exists(/databases/$(database)/documents/players/$(request.auth.uid));

      allow update: if false;

      allow delete: if isSignedIn()
        && isValidId(adId)
        && (isAdmin() || resource.data.ownerUid == request.auth.uid);
    }

    // 6. Verified Instagram Followers Registry (@typixelofficial & @typixel.studio)
    // Exact-ID get only (no public list scraping; zero PII). Only verified Admin may write/list/delete.
    match /verifiedFollowers/{igDocId} {
      allow get: if isValidIgDocId(igDocId);
      allow list: if isBootstrappedAdmin();

      allow create: if isAdmin()
        && isValidIgDocId(igDocId)
        && isValidVerifiedFollower(request.resource.data, igDocId)
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && isValidIgDocId(igDocId)
        && isValidVerifiedFollower(request.resource.data, igDocId)
        && request.resource.data.instagramId == resource.data.instagramId
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'followsOfficial', 'followsStudio', 'source', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidIgDocId(igDocId);
    }
  }
}
